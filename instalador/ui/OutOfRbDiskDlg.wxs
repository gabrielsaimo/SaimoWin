<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <Fragment>
        <UI>
            <Dialog Id="OutOfRbDiskDlg" Width="370" Height="270" Title="Instalação do [ProductName]">
                <Control Id="No" Type="PushButton" X="304" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="Não">
                    <Publish Event="EndDialog" Value="Return" />
                </Control>
                <Control Id="Yes" Type="PushButton" X="240" Y="243" Width="56" Height="17" Text="Sim">
                    <Publish Event="EnableRollback" Value="False" />
                    <Publish Event="EndDialog" Value="Return" />
                </Control>
                <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
                <Control Id="Text" Type="Text" X="20" Y="53" Width="330" Height="90" Text="Os discos marcados não têm espaço para o que foi escolhido. Libere espaço, instale menos coisas ou escolha outro disco. Dá também para desligar a volta atrás do instalador, que é o que devolveria o computador ao estado anterior se a instalação parasse no meio. Clique em Sim para correr esse risco." />
                <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
                <Control Id="Description" Type="Text" X="20" Y="20" Width="280" Height="20" Transparent="yes" NoPrefix="yes" Text="Não há espaço em disco suficiente para a instalação." />
                <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Out of Disk Space" />
                <Control Id="VolumeList" Type="VolumeCostList" X="20" Y="150" Width="330" Height="70" Sunken="yes" Fixed="yes" Remote="yes" ShowRollbackCost="yes" Text="{120}{70}{70}{70}{70}" />
            </Dialog>
        </UI>
    </Fragment>
</Wix>
